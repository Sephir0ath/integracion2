{
  "uid": "ticketera-circuit-breaker",
  "title": "Ticketera · Circuit Breaker",
  "description": "Estado, transiciones y rechazos fail-fast del circuito sobre la pasarela externa.",
  "tags": [
    "ticketera",
    "resiliencia",
    "circuito"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Qué mirar en este panel",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "targets": [],
      "options": {
        "mode": "markdown",
        "content": "**Circuito de la pasarela.** La banda de color muestra el estado activo: verde `CLOSED` (todo pasa), rojo `OPEN` (se rechaza al instante, sin tocar la dependencia) y naranjo `HALF_OPEN` (una llamada de prueba). Abajo, los rechazos *fail-fast* y las transiciones: el circuito abre al tercer intento fallido y se cierra solo cuando la dependencia vuelve."
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "state-timeline",
      "title": "Estado del circuit breaker (CLOSED → OPEN → HALF_OPEN)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "circuit_breaker_state{breaker=\"pasarela\"} == 1",
          "legendFormat": "{{state}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CLOSED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 90
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OPEN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 90
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HALF_OPEN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 90
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          }
        ]
      }
    },
